# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- VILA GPT -------------------------------------------------------
# Senha da área de administração do VILA GPT (mínimo 6 caracteres).
# Sem ela, ninguém consegue cadastrar ou alterar a base oficial.
VILA_GPT_ADMIN_PIN=

# Recomendado: um texto longo e aleatório que assina o cookie de administrador
# (ex.: saída de `openssl rand -hex 32`). Sem ele, a assinatura deriva da senha.
VILA_GPT_SESSION_SECRET=

# Chave da API da Anthropic (console.anthropic.com). Com ela a IA redige
# as respostas a partir das fontes oficiais. Sem ela o VILA GPT funciona
# em modo busca: mostra o procedimento oficial mais parecido.
ANTHROPIC_API_KEY=

# Opcionais
# VILA_GPT_MODEL=claude-opus-5        # modelo (padrão: claude-opus-5; claude-sonnet-5 é mais barato)
# VILA_GPT_EFFORT=medium              # low | medium | high (padrão: medium)
# VILA_GPT_MAX_AI_PER_DAY=500         # depois disso cai para o modo busca até o dia seguinte
# SUPABASE_SERVICE_ROLE_KEY=          # só se for rodar supabase/vila-gpt-lock.sql

# ---- Sistema de gestão de cozinha ------------------------------------
# Chave de serviço do Supabase (Project Settings > API > service_role). Usada
# SÓ no servidor para: criar usuários com senha na tela Usuários, varredura
# diária de alertas (cron) e API de integrações. Nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do cron da Vercel (Settings > Environment Variables > CRON_SECRET).
CRON_SECRET=

# Permite que qualquer pessoa crie conta na tela de login (padrão: só o
# primeiro administrador e e-mails convidados).
NEXT_PUBLIC_ALLOW_SIGNUP=false
