# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# KDS - integracao oficial com o iFood (Merchant API)
#
# ATENCAO: nenhuma destas variaveis tem prefixo NEXT_PUBLIC_.
# Elas sao lidas SO no servidor (rotas em src/app/api) e nunca vao para o
# navegador. Nao coloque credencial do iFood em variavel NEXT_PUBLIC_.
#
# Pegue Client ID e Client Secret no Portal do Desenvolvedor iFood:
#   https://developer.ifood.com.br
# A aplicacao precisa dos modulos Order e Events e de passar pela homologacao.
# ---------------------------------------------------------------------
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# ID da loja. Varias lojas: separe por virgula.
IFOOD_MERCHANT_ID=
# Opcional - o padrao ja e o endereco de producao da Merchant API.
# IFOOD_API_BASE=https://merchant-api.ifood.com.br

# Opcional: chave service role do Supabase para as rotas de servidor.
# Sem ela o servidor usa a chave anon (as policies do schema ja liberam).
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: amarra as comandas do KDS a uma empresa do cadastro.
# KDS_COMPANY_ID=22222222-2222-4222-8222-222222222222
